import api from '../lib/api'

export const getInventory = async () => {
  const res = await api.get('/inventory', { withCredentials: true })
  return res.data.data
}

export const getInventoryById = async (id: number) => {
  const res = await api.get(`/inventory/${id}`, { withCredentials: true })
  return res.data.data
}

export const createInventory = async (payload: any) => {
  const res = await api.post('/inventory', payload, { withCredentials: true })
  return res.data.data
}

export const updateInventory = async (id: number, payload: any) => {
  const res = await api.put(`/inventory/${id}`, payload, { withCredentials: true })
  return res.data.data
}

export const deleteInventory = async (id: number) => {
  const res = await api.delete(`/inventory/${id}`, { withCredentials: true })
  return res.data
}

export default { getInventory, getInventoryById, createInventory, updateInventory, deleteInventory }
